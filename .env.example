NEWPLATFORM_ADDR=127.0.0.1:8080
NEWPLATFORM_DB_PATH=./data/newplatform.db
NEWPLATFORM_ANSIBLE_BIN=ansible-playbook
NEWPLATFORM_RUN_ROOT=./data/runs
NEWPLATFORM_ALLOWED_ANSIBLE_ROOTS=./examples/ansible
# Go SSH 环境检查严格校验该文件，不会自动信任新主机。
# NEWPLATFORM_SSH_KNOWN_HOSTS=/absolute/path/to/.ssh/known_hosts
NEWPLATFORM_KILL_GRACE=3s
NEWPLATFORM_MAX_LOG_BYTES=2097152
# identities 只创建角色切换账号，不导入组件、场景和环境样例。
NEWPLATFORM_SEED_PROFILE=demo
# 启用 Draft 版本的 Dockerfile 构建与推送；镜像路径由平台固定生成。
# NEWPLATFORM_IMAGE_REGISTRY=192.168.88.116:5000
NEWPLATFORM_IMAGE_BUILD_ROOT=./data/image-builds
NEWPLATFORM_DOCKER_BIN=docker
# 批准并执行 Kubernetes 1.17.5 作业前再设置：32 字节密钥的 base64 值。
# NEWPLATFORM_K8S1175_ENCRYPTION_KEY=
