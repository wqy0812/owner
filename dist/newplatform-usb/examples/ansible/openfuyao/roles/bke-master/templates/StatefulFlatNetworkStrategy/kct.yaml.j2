apiVersion: bke.bocloud.com/v1beta1
kind: KubeletConfig
metadata:
  generation: 1
  labels:
    component: kubelet
    test: "true"
  name: kct-{{ cluster_id_lower }}
  namespace: default
spec:
  commands:
  - args:
    - -c
    - |
      echo "=== KubeletConfig CR 测试命令执行 ===" >> /var/log/kubelet-commands.log
      echo "执行时间: $(date +%Y-%m-%d_%H:%M:%S)" >> /var/log/kubelet-commands.log
      echo "kubelet 配置路径: ${kubeletConfigPath}" >> /var/log/kubelet-commands.log
      if [ -f "${kubeletConfigPath}" ]; then
        echo "kubelet.conf 存在，大小: $(du -sh ${kubeletConfigPath} | awk '{print $1}')" >> /var/log/kubelet-commands.log
      else
        echo "警告：kubelet.conf 不存在" >> /var/log/kubelet-commands.log
      fi
    command: /bin/bash
    workingDir: /var/log
  - args:
    - is-active
    - containerd.service
    command: /usr/bin/systemctl
    workingDir: /
  kubeletConfig:
    kubelet.conf:
      raw: |
        apiVersion: kubelet.config.k8s.io/v1beta1
        kind: KubeletConfiguration
        authentication:
          anonymous:
            enabled: false
          webhook:
            cacheTTL: 0s
            enabled: true
          x509:
            clientCAFile: /etc/kubernetes/pki/ca.crt
        authorization:
          mode: Webhook
          webhook:
            cacheAuthorizedTTL: 0s
            cacheUnauthorizedTTL: 0s
        address: 0.0.0.0
        cgroupDriver: systemd
        clusterDNS:
          - "{{ CLUSTER_DNS_SVC_IP }}"
        clusterDomain: "cluster.local"
        healthzBindAddress: 127.0.0.1
        healthzPort: 10248
        rotateCertificates: true
        staticPodPath: /etc/kubernetes/manifests
        streamingConnectionIdleTimeout: 4h0m0s
        syncFrequency: 1m0s
        volumeStatsAggPeriod: 1m0s
        containerLogMaxSize: "400Mi"
        containerLogMaxFiles: 10
  kubeletService:
    enabled: true
    install:
      requiredBy: []
      wantedBy:
      - multi-user.target
    service:
      execStart: /usr/bin/kubelet --bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf
        --kubeconfig=/etc/kubernetes/admin.conf --config=/var/lib/kubelet/config.yaml
        --cgroup-driver=systemd
        --register-node=true
        --v=4
        --maximum-dead-containers=100
        --maximum-dead-containers-per-container=4
        --minimum-container-ttl-duration=24h0m
        --fail-swap-on=false
        --allowed-unsafe-sysctls=net.*
        --image-gc-low-threshold=50
        --image-gc-high-threshold=75
        --eviction-hard=imagefs.available<10%
        --eviction-minimum-reclaim=imagefs.available=0.5Gi
        --image-credential-provider-config=/etc/icbc/image-credential-provider.yaml
        --image-credential-provider-bin-dir=/usr/local/bin/kubelet-credential-providers
      group: root
      killMode: process
      restart: always
      restartSec: 10
      standardError: journal+console
      standardOutput: journal+console
      startLimitBurst: 5
      syslogIdentifier: kubelet
      user: root
      workingDirectory: /var/lib/kubelet
    serviceName: kubelet
    unit:
      after:
      - containerd.service
      - network-online.target
      description: Kubernetes Kubelet (Test)
      documentation: https://kubernetes.io/docs/concepts/overview/components/#kubelet
      requires:
      - containerd.service
      wants:
      - network-online.target
    variables:
      containerdEndpoint: unix:///run/containerd/containerd.sock
      kubeletBinaryPath: /usr/bin/kubelet
      kubeletConfigPath: /etc/kubernetes/kubelet.conf
      nodeName: node-01
