{%- if cluster_role == "manager" %}
{% for host in groups['management_cluster_k8smaster'] %}
---
apiVersion: bke.bocloud.com/v1beta1
kind: BKENode
metadata:
  labels:
    cluster.x-k8s.io/cluster-name: {{ cluster_id_lower }}
  name: {{ host }}
  namespace: bke-{{ cluster_id_lower }}
spec:
  hostname: {{ host }}
  ip: {{ host }}
  password: "{{ hostvars[host]['ansible_ssh_pass'] }}"
  port: "22"
  role:
  - master/node
  - etcd
  username: {{ hostvars[host]['ansible_user'] }}
status: {}
{% endfor %}
{%- elif cluster_role == "work" %}
{% for host in groups['work_cluster_k8smaster'] %}
---
apiVersion: bke.bocloud.com/v1beta1
kind: BKENode
metadata:
  labels:
    cluster.x-k8s.io/cluster-name: {{ cluster_id_lower }}
  name: {{ host }}
  namespace: bke-{{ cluster_id_lower }}
spec:
  hostname: {{ host }}
  ip: {{ host }}
  password: "{{ hostvars[host]['ansible_ssh_pass'] }}"
  port: "22"
  role:
  - master/node
  - etcd
  username: {{ hostvars[host]['ansible_user'] }}
status: {}
{% endfor %}
{% endif %}
