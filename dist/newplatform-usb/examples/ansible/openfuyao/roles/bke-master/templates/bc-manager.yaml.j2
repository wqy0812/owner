apiVersion: bke.bocloud.com/v1beta1
kind: BKECluster
metadata:
  name: {{ cluster_id_lower }}
  namespace: bke-{{ cluster_id_lower }}
spec:
  KubeletConfigRef:
    name: kct-{{ cluster_id_lower }}
    namespace: default
  clusterConfig:
    addons:
    - block: true
      name: harbor-secret-addon
      param:
        dockerconfigjson: {{ harbor_config_json }}
      version: {{ harbor_secret_version }}
    - name: kubeproxy
      param:
        clusterNetworkMode: calico
      version: {{ kubeproxy_version }}
    - block: true
      name: calico
      param:
        calicoMode: vxlan
        ipAutoDetectionMethod: skip-interface=nerdctl*
        hostPortMin: {{ PORTMAP_HOST_PORT_MIN }}
        hostPortMax: {{ PORTMAP_HOST_PORT_MAX }}
        podSubnet: {{ CLUSTER_IP_RANGE_IPV4 }}
        podSubnetBlockSize: 27
      version: {{ calico_version }}
    - name: coredns
      param:
        EnableAntiAffinity: "true"
      version: {{ coredns_version }}
    - name: bkeagent-deployer
      param:
        tagVersion: {{ bkeagent_deployer_tag }}
      version: {{ bkeagent_deployer_version }}
    - block: true
      name: cluster-api
      param:
        containerdVersion: {{ containerd_version }}
        manage: "true"
        manifestsVersion: 1.0.5
        offline: "false"
        openFuyaoVersion: {{ openFuyao_version }}
        providerVersion: 1.0.4
        replicas: "1"
        sandbox: {{ ENV_DOCKER_HARBOR_DOMAIN }}/google_containers/pause:{{ pause_tag }}
      version: {{ cluster_api_version }}
    cluster:
      agentHealthPort: "58080"
      apiServer:
        extraArgs:
          max-mutating-requests-inflight: "1500"
          max-requests-inflight: "500"
          watch-cache-sizes: node#1000,pod#5000
          profiling: "true"
          tls-min-version: VersionTLS13
          anonymous-auth: "false"
          enable-admission-plugins: NodeRestriction
          delete-collection-workers: "5"
          enable-aggregator-routing: "true"
          event-ttl: 1h
          runtime-config: api/all=true
          authorization-mode: Node,RBAC
          v: "4"
      certificatesDir: /etc/kubernetes/pki
      containerRuntime:
        cri: containerd
        param:
          data-root: /var/lib/containerd
        runtime: runc
      containerdConfigRef:
        name: cct-{{ cluster_id_lower }}
        namespace: default
      containerdVersion: {{ containerd_version }}
      controllerManager:
        extraArgs:
          kube-api-burst: "300"
          kube-api-qps: "200"
          profiling: "true"
          node-startup-grace-period: 60s
          tls-min-version: VersionTLS13
          cluster-signing-duration: 876000h
          controllers: "*,bootstrapsigner,tokencleaner"
          authorization-always-allow-paths: /healthz,/metrics
          concurrent-gc-syncs: "200"
          horizontal-pod-autoscaler-sync-period: 10s
          secondary-node-eviction-rate: "0"
          unhealthy-zone-threshold: "0.2"
          allocate-node-cidrs: "false"
          v: "4"
      etcd:
        extraArgs:
          tls-min-version: TLS1.3
          quota-backend-bytes: "8589934592"
          heartbeat-interval: "2000"
          election-timeout: "10000"
          enable-pprof: "true"
        dataDir: /var/lib/etcd
      etcdVersion: {{ etcd_version }}
      httpRepo:
        domain: {{ ENV_FILESTATION_DOMAIN }}
        ip: {{ ENV_FILESTATION_IP }}
        port: "{{ ENV_FILESTATION_PORT }}"
        prefix: "{{ ENV_FILESTATION_PREFIX }}"
      imageRepo:
        domain: {{ ENV_DOCKER_HARBOR_DOMAIN }}
        ip: {{ ENV_DOCKER_HARBOR_IP }}
        port: "{{ ENV_DOCKER_HARBOR_PORT }}"
        prefix: {{ ENV_DOCKER_HARBOR_PORJECT }}
      kubelet:
        extraArgs:
          kube-api-burst: "2000"
          kube-api-qps: "1000"
        extraVolumes:
        - hostPath: /var/lib/kubelet
          name: kubelet-root-dir
      kubernetesVersion: {{ kubernetes_version }}
      networking:
        dnsDomain: cluster.local
        podSubnet: {{ CLUSTER_IP_RANGE_IPV4 }}
        serviceSubnet: {{ SERVICE_IP_RANGE_IPV4 }}
      ntpServer: cn.pool.ntp.org:123
      openFuyaoVersion: {{ openFuyao_version }}
      scheduler:
        extraArgs:
          kube-api-qps: "200"
          kube-api-burst: "300"
          tls-min-version: VersionTLS13
          v: "4"
    customExtra:
      chartRepoPort: "{{ ENV_CHART_REPO_PORT }}"
      clusterapi: 1.0.5
      containerd: containerd-{{ containerd_version }}-linux-{.arch}.tar.gz
      domain: {{ ENV_DOCKER_HARBOR_DOMAIN }}
      host: {{ ENV_DOCKER_HARBOR_IP }}
      imageRepoPort: "{{ ENV_DOCKER_HARBOR_PORT }}"
      nfsserverpath: /
      otherRepo: ""
      otherRepoIp: ""
      otherSource: ""
      yumRepoPort: ""
{% if groups.get('management_cluster_F5', []) | length > 0 %}
      extraLoadBalanceIP: {{ groups['management_cluster_F5'][0] }}
  controlPlaneEndpoint:
    host: {{ groups['management_cluster_F5'][0] }}
    port: 6443
{% else %}
      extraLoadBalanceIP: {{ groups['management_cluster_k8smaster'][0] }}
  controlPlaneEndpoint:
    host: {{ groups['management_cluster_k8smaster'][0] }}
    port: 6443
{% endif %}
  pause: false
status:
  agentStatus: {}
  ready: false
