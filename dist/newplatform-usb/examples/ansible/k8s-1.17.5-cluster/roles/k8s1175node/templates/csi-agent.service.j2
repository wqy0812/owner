[Unit]
Description=csi-agent
After=network.target

[Service]
ExecStart=/approot1/paas/kube/csi/bin/csi-agent -hostname={{ inventory_hostname }} -kubeconfig=/approot1/paas/kube/cert/kubectl.kubeconfig --logtostderr=true -v=4 -shelldir=/usr/local/VPMGR
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
