#!/bin/bash
wd=$(cd $(dirname $0);pwd)
{%- if inventory_hostname is sameas play_hosts[0] %} 
${wd}/etcd --name infra0 \
{% endif %}
{%- if inventory_hostname is sameas play_hosts[1] %} 
${wd}/etcd --name infra1 \
{% endif %}
{%- if inventory_hostname is sameas play_hosts[2] %} 
${wd}/etcd --name infra2 \
{% endif %}
  --data-dir=${wd}/data \
  --quota-backend-bytes=8589934592 \
  --cert-file=/approot1/paas/etcd/cert/etcd.pem \
  --key-file=/approot1/paas/etcd/cert/etcd-key.pem \
  --trusted-ca-file=/approot1/paas/etcd/cert/ca.pem \
  --peer-cert-file=/approot1/paas/etcd/cert/etcd.pem \
  --peer-key-file=/approot1/paas/etcd/cert/etcd-key.pem \
  --peer-trusted-ca-file=/approot1/paas/etcd/cert/ca.pem \
  --peer-client-cert-auth \
  --client-cert-auth \
  --heartbeat-interval '2000' \
  --election-timeout '10000' \
  --initial-advertise-peer-urls https://{{ inventory_hostname }}:{{ K8SETCD_PEER_PORT }} \
  --listen-peer-urls https://{{ inventory_hostname }}:{{ K8SETCD_PEER_PORT }} \
  --listen-client-urls https://{{ inventory_hostname }}:{{ K8SETCD_CLIENT_PORT }},https://127.0.0.1:{{ K8SETCD_CLIENT_PORT }} \
  --advertise-client-urls https://{{ inventory_hostname }}:{{ K8SETCD_CLIENT_PORT }} \
  --initial-cluster-token etcd-cluster-0 \
  --initial-cluster infra0=https://{{ play_hosts[0] }}:{{ K8SETCD_PEER_PORT }},infra1=https://{{ play_hosts[1] }}:{{ K8SETCD_PEER_PORT }},infra2=https://{{ play_hosts[2] }}:{{ K8SETCD_PEER_PORT }} \
  --initial-cluster-state new \
  --log-output 'stdout' --log-output 'stderr' 1>>${wd}/etcd.log 2>&1
