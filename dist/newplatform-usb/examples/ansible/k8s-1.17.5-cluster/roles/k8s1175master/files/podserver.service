[Unit]
Description=podSevrer
After=network.target

[Service]
EnvironmentFile=-/approot1/paas/kube/podserver/conf/podserver
User=kube
ExecStart=/approot1/paas/kube/podserver/bin/podServer \
	    $PODSERVER_API_ADDR \
	    $K8SMASTER_ADDR &
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target