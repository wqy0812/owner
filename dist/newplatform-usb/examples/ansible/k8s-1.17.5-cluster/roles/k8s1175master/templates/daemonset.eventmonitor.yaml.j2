
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: eventmonitor
  labels:
    app: eventmonitor
spec:
  selector:
    matchLabels:
      app: eventmonitor
  template:
    metadata:
      labels:
        app: eventmonitor
    spec:
      dnsPolicy: Default
      containers:
        - name: eventmonitor
          image: {{ NETWORK_CLASSIFIED_HARBOR_DOMAIN }}/hzyfzc/eventmonitor:26.1
          volumeMounts: 
          - name: localtime
            mountPath: /etc/localtime
          - name: container-logs
            mountPath: /home/containers
          env:
            - name: ENV_CLUSTER_LB_IP
              value: "{{ CLUSTER_API_ADDR }}"
            - name: ENV_CLUSTER_LB_PORT
              value: "{{ CLUSTER_API_PORT }}"
            - name: ENV_PAAS2_ADMIN_ADDR
              value: "{{ ENV_PAAS_ADMIN_CLIENT_ADDRESS }}"
            - name: ENV_PAAS_NODE_NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: PRM_MONITOR_INTERVAL
              value: "60"
            - name: ENV_LOG_RECYCLE_TIME
              value: "7d"
            - name: ENV_CONTAINER_RUN_TIME
              value: "docker"
            - name: ENV_HDFS_CONF_PREFIX
              value: "prod"
            - name: TZ
              value: "Asia/Shanghai"
            - name: LOG4J_FORMAT_MSG_NO_LOOKUPS
              value: "true"
      volumes: 
      - name: localtime
        hostPath: 
          path: /etc/localtime
      - name: container-logs
        hostPath:
          path: /var/lib/docker/containers