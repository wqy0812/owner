#!/bin/sh
su - kube
cd /approot1/paas/kube/cert
/approot1/paas/kube/bin/kubectl config set-cluster kubernetes \
  --server=https://{{ groups['k8s_F5'][0] }}:6443 \
  --certificate-authority=/approot1/paas/kube/cert/ca.pem \
  --embed-certs=true \
  --kubeconfig=prometheus.kubeconfig

/approot1/paas/kube/bin/kubectl config set-credentials prometheus-sa \
  --token={{ TOKEN }} \
  --kubeconfig=prometheus.kubeconfig

/approot1/paas/kube/bin/kubectl config set-context default \
  --cluster=kubernetes \
  --user=prometheus-sa \
  --kubeconfig=prometheus.kubeconfig

/approot1/paas/kube/bin/kubectl config use-context default --kubeconfig=prometheus.kubeconfig