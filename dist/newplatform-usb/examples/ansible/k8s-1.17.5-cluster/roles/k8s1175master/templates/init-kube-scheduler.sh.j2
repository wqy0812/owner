#!/bin/sh
su - kube
cd /approot1/paas/kube/cert/kube-scheduler
/approot1/paas/kube/bin/kubectl config set-cluster kubernetes \
  --certificate-authority=/approot1/paas/kube/cert/ca.pem \
  --embed-certs=true \
  --server=https://{{ groups['k8s_F5'][0] }}:6443/ \
  --kubeconfig=kube-scheduler.kubeconfig

/approot1/paas/kube/bin/kubectl config set-credentials system:kube-scheduler \
  --client-certificate=kube-scheduler.pem \
  --client-key=kube-scheduler-key.pem \
  --embed-certs=true \
  --kubeconfig=kube-scheduler.kubeconfig

/approot1/paas/kube/bin/kubectl config set-context system:kube-scheduler \
  --cluster=kubernetes \
  --user=system:kube-scheduler \
  --kubeconfig=kube-scheduler.kubeconfig

/approot1/paas/kube/bin/kubectl config use-context system:kube-scheduler --kubeconfig=kube-scheduler.kubeconfig