KUBE_API_ADDRESS="--insecure-bind-address=127.0.0.1 --insecure-bind-address={{ inventory_hostname }}"

KUBE_API_PORT="--port=0"

KUBE_ETCD_SERVERS="--etcd-servers=https://{{ groups['k8setcd'][0] }}:{{ K8SETCD_CLIENT_PORT }},https://{{ groups['k8setcd'][1] }}:{{ K8SETCD_CLIENT_PORT }},https://{{ groups['k8setcd'][2] }}:{{ K8SETCD_CLIENT_PORT }}"

KUBE_SERVICE_ADDRESSES="--service-cluster-ip-range={{ SERVICE_IP_RANGE }}"

KUBE_ADMISSION_CONTROL="--enable-admission-plugins=NodeRestriction"

KUBE_API_ARGS="--tls-cert-file=/approot1/paas/kube/cert/kubernetes/kubernetes.pem \
               --tls-private-key-file=/approot1/paas/kube/cert/kubernetes/kubernetes-key.pem \
               --client-ca-file=/approot1/paas/kube/cert/cb-ca.pem \
               --kubelet-client-certificate=/approot1/paas/kube/cert/kubernetes/kubernetes.pem \
               --kubelet-client-key=/approot1/paas/kube/cert/kubernetes/kubernetes-key.pem \
               --service-account-key-file=/approot1/paas/kube/cert/ca-key.pem \
               --etcd-cafile=/approot1/paas/kube/cert/ca.pem \
               --etcd-certfile=/approot1/paas/kube/cert/kubernetes/kubernetes.pem \
               --etcd-keyfile=/approot1/paas/kube/cert/kubernetes/kubernetes-key.pem \
               --experimental-encryption-provider-config=/approot1/paas/kube/cert/encryption-config.yaml \
               --allow-privileged=true \
               --enable-swagger-ui=true \
               --apiserver-count={{ groups['k8smaster'] | length }} \
               --audit-log-maxage=30 \
               --audit-log-maxbackup=3 \
               --audit-log-maxsize=100 \
               --audit-log-path=/approot1/paas/kube/logs/kube-apiserver-audit.log \
               --event-ttl=1h \
               --authorization-mode=Node,RBAC \
               --runtime-config=api/all=true \
               --anonymous-auth=false \
               --enable-bootstrap-token-auth \
               --service-node-port-range=20000-40000 \
               --bind-address={{ inventory_hostname }} \
               --enable-aggregator-routing=true \
               --proxy-client-cert-file=/approot1/paas/kube/cert/aggregator.pem \
               --proxy-client-key-file=/approot1/paas/kube/cert/aggregator-key.pem \
               --requestheader-client-ca-file=/approot1/paas/kube/cert/front-proxy-ca.pem \
               --requestheader-allowed-names=front-proxy-client \
               --requestheader-extra-headers-prefix="X-Remote-Extra-" \
               --requestheader-group-headers=X-Remote-Group \
               --requestheader-username-headers=X-Remote-User \
			   "
