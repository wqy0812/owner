#!/bin/sh
{% for i in range((play_hosts|length)) %}
{% if inventory_hostname is sameas play_hosts[i] %}
sleep {{ i }}
{% endif %}
{% endfor %}
su - kube
cd /approot1/paas/kube/cert
echo ">>> {{ k8s1175_bootstrap_node | default(inventory_hostname) }}"
# 创建 token
export BOOTSTRAP_TOKEN=$(/approot1/paas/kube/bin/kubeadm token create \
  --description kubelet-bootstrap-token \
  --groups system:bootstrappers:1 \
  --kubeconfig /approot1/paas/kube/cert/kubectl.kubeconfig)
# 设置集群参数
/approot1/paas/kube/bin/kubectl config set-cluster kubernetes \
  --certificate-authority=/approot1/paas/kube/cert/ca.pem \
  --embed-certs=true \
  --server=https://{{ groups['k8s_F5'][0] }}:6443 \
  --kubeconfig=kubelet-bootstrap-{{ k8s1175_bootstrap_node | default(inventory_hostname) }}.kubeconfig
# 设置客户端认证参数
/approot1/paas/kube/bin/kubectl config set-credentials kubelet-bootstrap \
  --token=${BOOTSTRAP_TOKEN} \
  --kubeconfig=kubelet-bootstrap-{{ k8s1175_bootstrap_node | default(inventory_hostname) }}.kubeconfig
# 设置上下文参数
/approot1/paas/kube/bin/kubectl config set-context default \
  --cluster=kubernetes \
  --user=kubelet-bootstrap \
  --kubeconfig=kubelet-bootstrap-{{ k8s1175_bootstrap_node | default(inventory_hostname) }}.kubeconfig
# 设置默认上下文
/approot1/paas/kube/bin/kubectl config use-context default --kubeconfig=kubelet-bootstrap-{{ k8s1175_bootstrap_node | default(inventory_hostname) }}.kubeconfig
