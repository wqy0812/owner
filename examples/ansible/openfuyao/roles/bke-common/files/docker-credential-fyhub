#!/bin/bash
# 注意：所有调试信息输出到 stderr (> &2)
# === 加密凭证文件路径 ===
CRED_FILE="/etc/icbc/encrypted-credentials/fyhub_encrypted.conf"
KEY_FILE="/etc/icbc/encrypted-credentials/.aes_master.key"
# === 函数：解密加密字符串 ===
decrypt_string() {
    local encrypted_text="$1"
    if [[ -z "${encrypted_text}" ]]; then
        echo "ERROR: 要解密的文本为空" >&2
        return 1
    fi
    # 读取解密密钥
    if [[ ! -f "${KEY_FILE}" ]]; then
        echo "ERROR: 解密密钥文件未找到：${KEY_FILE}" >&2
        return 1
    fi
    # 获取密钥（严格处理）
    local decryption_key=$(grep -v '^[[:space:]]*$' "${KEY_FILE}" | head -1 | tr -d '
\r')
    if [[ -z "${decryption_key}" ]]; then
        echo "ERROR: 解密密钥为空或读取失败" >&2
        return 1
    fi
    # 使用 base64 解码后再解密
    local decrypted_text="$(echo "${encrypted_text}" | base64 -d 2>/dev/null | openssl enc -d -aes-256-cbc -md sha256 -salt -pbkdf2 -iter 100000 -pass pass:"${decryption_key}" 2>&1)"
    local decrypt_status=$?
    if [[ ${decrypt_status} -ne 0 ]]; then
        echo "ERROR: 解密失败，状态码 ${decrypt_status}" >&2
        echo "ERROR: 解密错误：${decrypted_text}" >&2
        return 1
    fi
    echo "${decrypted_text}"
    return 0
}
# === 函数：加载并解密凭证 ===
load_and_decrypt_credentials() {
    # 检查文件是否存在
    if [[ ! -f "${CRED_FILE}" ]]; then
        echo "ERROR: 加密凭证文件未找到：${CRED_FILE}" >&2
        return 1
    fi
    # 读取加密的用户名和密码
    local encrypted_username=""
    local encrypted_password=""
    # 从加密文件读取
    while IFS='=' read -r key value; do
        key="$(echo "${key}" | tr -d '[:space:]')"
        value="$(echo "${value}" | tr -d '[:space:]')"
        case "${key}" in
            "ENC_USERNAME")
                encrypted_username="${value}"
                ;;
            "ENC_PASSWORD")
                encrypted_password="${value}"
                ;;
        esac
    done < "${CRED_FILE}"
    # 检查是否成功读取
    if [[ -z "${encrypted_username}" || -z "${encrypted_password}" ]]; then
        echo "ERROR: 无法从凭证文件读取加密的用户名或密码" >&2
        return 1
    fi
    # 解密用户名
    DECRYPTED_USERNAME="$(decrypt_string "${encrypted_username}")"
    if [[ $? -ne 0 || -z "${DECRYPTED_USERNAME}" ]]; then
        echo "ERROR: 用户名解密失败或解密结果为空" >&2
        return 1
    fi
    # 解密密码
    DECRYPTED_PASSWORD="$(decrypt_string "${encrypted_password}")"
    if [[ $? -ne 0 || -z "${DECRYPTED_PASSWORD}" ]]; then
        echo "ERROR: 密码解密失败或解密结果为空" >&2
        return 1
    fi
    return 0
}
# === 函数：从镜像地址提取 registry ===
extract_registry() {
    local image="$1"
    echo "${image}" | cut -d'/' -f1
}
# === 主程序 ===
# 1.从标准输入读取请求
STDIN_DATA="$(cat)"
# 2.解析镜像地址和 API 版本
# 2.解析镜像地址和 API 版本
IMAGE="$(echo "${STDIN_DATA}" | jq -r .image)"
API_VERSION="$(echo "${STDIN_DATA}" | jq -r .apiVersion)"

# 3.如果没有获取到镜像地址，返回空响应
if [[ -z "${IMAGE}" ]]; then
    echo '{"kind":"CredentialProviderResponse","apiVersion":"credentialprovider.kubelet.k8s.io/v1","cacheKeyType":"","auth":{}}'
    exit 0
fi
# 4.从镜像地址提取 registry
REGISTRY=$(extract_registry "${IMAGE}")
if [[ -z "${REGISTRY}" ]]; then
    echo '{"kind":"CredentialProviderResponse","apiVersion":"credentialprovider.kubelet.k8s.io/v1","cacheKeyType":"","auth":{}}'
    exit 0
fi
# 5.加载并解密凭证
if ! load_and_decrypt_credentials; then
    # 解密失败，返回空响应
    echo '{"kind":"CredentialProviderResponse","apiVersion":"credentialprovider.kubelet.k8s.io/v1","cacheKeyType":"","auth":{}}'
    exit 0
fi
# 6.返回认证信息（使用 cacheKeyType）
cat <<EOF
{
  "kind": "CredentialProviderResponse",
  "apiVersion": "${API_VERSION}",
  "cacheKeyType": "Registry",
  "auth": {
    "${REGISTRY}": {
      "username": "${DECRYPTED_USERNAME}",
      "password": "${DECRYPTED_PASSWORD}"
    }
  }
}
EOF
