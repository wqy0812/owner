      "riskLevel": "low",
      "destructive": false,
      "idempotent": false,
      "id": "precheck",
      "entry": "tasks/precheck.yml",
      "preCheckActionId": "",
      "postCheckActionId": ""
    },
    {
      "name": "安装后检查",
      "kind": "check",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 900,
      "riskLevel": "low",
