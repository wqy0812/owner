{
  "slug": "docker-runtime",
  "name": "Docker",
  "description": "核验测试环境既有 Docker 20.10.21、数据目录和 cgroup 驱动，管理服务启停及恢复；不替换既有 Docker 软件包。",
  "referenceVersion": "20.10.21-env2.1",
  "target": {
    "ansible": "2.8.8",
    "python": "3.6.9",
    "operatingSystem": "Ubuntu",
    "osVersion": "18.04",
    "architecture": "amd64",
    "ipFamily": "IPv4"
  },
  "parameters": [
    {
      "name": "docker_version",
      "description": "Docker 精确版本；按参数提供方维护。",
      "type": "string",
      "required": true,
      "visibility": "internal",
      "modifiable": false,
      "valueProvider": "component_owner",
      "fixedValue": "20.10.21"
    },
    {
      "name": "docker_data_dir",
      "description": "Docker 数据目录；按参数提供方维护。",
      "type": "string",
      "required": true,
      "visibility": "public",
      "modifiable": true,
      "valueProvider": "environment_owner",
      "suggestedValue": "/var/lib/docker",
      "environmentBinding": {
        "kind": "private"
      }
    }
  ],
  "dependencies": [
    {
      "component": "host-bootstrap",
      "version": "1.17.5-env2.1",
      "kind": "execution",
      "parameterMappings": []
    }
  ],
  "images": [],
  "artifacts": [],
  "actions": [
    {
      "name": "安装前检查",
      "kind": "check",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 600,
      "riskLevel": "low",
      "destructive": false,
      "idempotent": false,
      "id": "precheck",
      "entry": "tasks/precheck.yml",
      "preCheckActionId": "",
      "postCheckActionId": ""
    },
    {
      "name": "安装后检查",
      "kind": "check",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 600,
      "riskLevel": "low",
      "destructive": false,
      "idempotent": false,
      "id": "postcheck",
      "entry": "tasks/postcheck.yml",
      "preCheckActionId": "",
      "postCheckActionId": ""
    },
    {
      "name": "恢复后检查",
      "kind": "check",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 600,
      "riskLevel": "low",
      "destructive": false,
      "idempotent": false,
      "id": "rollback-postcheck",
      "entry": "tasks/rollback-postcheck.yml",
      "preCheckActionId": "",
      "postCheckActionId": ""
    },
    {
      "name": "安装与配置",
      "kind": "install",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 600,
      "riskLevel": "high",
      "destructive": false,
      "idempotent": false,
      "id": "install",
      "entry": "tasks/install.yml",
      "preCheckActionId": "precheck",
      "postCheckActionId": "postcheck"
    },
    {
      "name": "恢复安装前状态",
      "kind": "rollback",
      "become": true,
      "tags": [],
      "hostGroup": "all",
      "requiredCredentials": [],
      "timeoutSeconds": 600,
      "riskLevel": "high",
      "destructive": true,
      "idempotent": false,
      "id": "rollback",
      "entry": "tasks/rollback.yml",
      "preCheckActionId": "",
      "postCheckActionId": "rollback-postcheck"
    }
  ]
}
