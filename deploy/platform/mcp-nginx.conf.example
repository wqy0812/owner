# Include inside an existing TLS server {}. Expose only this location to MCP
# clients; the demo identity-switching UI/API must remain on the private network.
location = /mcp {
    client_max_body_size 3m;
    proxy_pass http://127.0.0.1:8080/mcp;
    proxy_http_version 1.1;
    # Preserve the upstream localhost Host expected by SDK DNS-rebinding checks.
    proxy_set_header Host 127.0.0.1:8080;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    # Keep Origin unchanged: the application validates exact allowedOrigins.
    # Do not log Authorization or request bodies.
}
