NEWPLATFORM_ADDR=0.0.0.0:8080
# Optional MCP endpoint; credentials contain only token hashes. See docs/mcp.md.
# CLUSTERFORGE_MCP_CONFIG=/etc/clusterforge/mcp-config.json
# CLUSTERFORGE_MCP_TRANSFER_DIR=/var/lib/clusterforge/mcp-transfers
NEWPLATFORM_DB_PATH=/var/lib/clusterforge/platform.db
NEWPLATFORM_SEED_PROFILE=identities
NEWPLATFORM_ANSIBLE_BIN=/usr/local/bin/ansible-playbook
NEWPLATFORM_RUN_ROOT=/var/lib/clusterforge/runs
NEWPLATFORM_ALLOWED_ANSIBLE_ROOTS=/opt/clusterforge/jobs
NEWPLATFORM_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
NEWPLATFORM_IMAGE_BUILD_ROOT=/var/lib/clusterforge/image-builds
NEWPLATFORM_DOCKER_BIN=/usr/bin/docker
CLUSTERFORGE_BACKUP_ENABLED=true
CLUSTERFORGE_BACKUP_DIR=/var/lib/clusterforge/catalog-backups
CLUSTERFORGE_CATALOG_REPO=/var/lib/clusterforge/catalog-repo
CLUSTERFORGE_CATALOG_REMOTE=origin
CLUSTERFORGE_CATALOG_BRANCH=catalog
CLUSTERFORGE_CATALOG_ALLOWED_ROOT=/var/lib/clusterforge/private-catalog-repositories
CLUSTERFORGE_BACKUP_DEBOUNCE=30s
