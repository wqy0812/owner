FROM golang:1.25.10-bookworm@sha256:154bd7001b6eb339e88c964442c0ad6ed5e53f09844cc818a41ce4ecb3ce3b43 AS go_toolchain
FROM ubuntu:18.04@sha256:152dc042452c496007f07ca9127571cb9c29697f42acbfad72324b2bb2e43c98 AS runtime
ENV DEBIAN_FRONTEND=noninteractive TZ=Asia/Shanghai
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git openssh-server python3 python3-dev python3-venv sudo build-essential iproute2 procps libffi-dev libssl-dev && apt-get clean && rm -rf /var/lib/apt/lists/*
COPY --from=go_toolchain /usr/local/go /usr/local/go
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
RUN python3 -m venv /opt/ansible && /opt/ansible/bin/pip install --no-cache-dir pip==21.3.1 setuptools==59.6.0 wheel==0.37.1 \
 && /opt/ansible/bin/pip install --no-cache-dir ansible==2.8.8 Jinja2==2.11.3 MarkupSafe==1.1.1 PyYAML==5.3.1 cryptography==3.4.8 cffi==1.15.1 pycparser==2.21 six==1.16.0 \
 && /opt/ansible/bin/python -c "import ansible,sys; assert ansible.__version__ == '2.8.8'; assert sys.version_info[:3] == (3,6,9)" \
 && /opt/ansible/bin/pip check \
 && useradd --create-home --shell /bin/bash testops \
 && printf 'testops ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/testops \
 && chmod 0440 /etc/sudoers.d/testops && passwd -d testops \
 && printf '\nPasswordAuthentication no\nChallengeResponseAuthentication no\nPermitRootLogin no\nPubkeyAuthentication yes\nAllowUsers testops\n' >> /etc/ssh/sshd_config
ENV PATH=/opt/ansible/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin GOPATH=/go GOCACHE=/var/cache/go-build PYTHONDONTWRITEBYTECODE=1
WORKDIR /workspace
